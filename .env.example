# Copy to .env.local (gitignored) for local development: cp .env.example .env.local
# Production values live in Netlify environment variables, never in this repo.
# Variables are grouped by the phase (docs/plan-v1.md, section N) that starts using them.

# --- Phase 0: core ---------------------------------------------------------------------
APP_ENV=development                # development | test | production
HOST=127.0.0.1                     # local API address; loopback keeps it off the network
PORT=8787                          # local API port; Vite proxies /api and /auth to it
APP_ORIGIN=http://localhost:5173   # the origin the browser uses (checked on every write)
# COMMIT_SHA=                      # set by the deploy pipeline; shown by /api/health

# --- Phase 1: database -----------------------------------------------------------------
# TURSO_DATABASE_URL=                       # default: <repo>/.data/todist.db; production: libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=                         # production only
# OWNER_EMAIL=you@example.com               # Google email that becomes the Owner at first sign-in

# --- Phase 2: sign-in ------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_SECRET=                      # 32+ random bytes, e.g. `openssl rand -base64 32`

# --- Phase 8: operations ---------------------------------------------------------------
# HEARTBEAT_URL=                   # optional healthchecks.io ping URL for the scheduler

# --- Phase 9: push notifications -------------------------------------------------------
# VAPID_PUBLIC_KEY=                # generate once: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Future: integrations ---------------------------------------------------------------
# DATA_ENCRYPTION_KEY=             # 32 random bytes; encrypts OAuth tokens at rest

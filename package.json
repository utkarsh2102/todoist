{
  "name": "todist",
  "private": true,
  "description": "Utkarsh's To-Do: a small, private, Todoist-style task manager.",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @todist/api --filter @todist/web run dev",
    "build": "pnpm --filter @todist/web run build",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "db:generate": "pnpm --filter @todist/api run db:generate",
    "db:migrate": "pnpm --filter @todist/api run db:migrate",
    "db:seed": "pnpm --filter @todist/api run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}

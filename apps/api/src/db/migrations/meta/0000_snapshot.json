      "checkConstraints": {
        "tasks_title": {
          "name": "tasks_title",
          "value": "length(\"tasks\".\"title\") BETWEEN 1 AND 300"
        },
        "tasks_priority": {
          "name": "tasks_priority",
          "value": "\"tasks\".\"priority\" IS NULL OR \"tasks\".\"priority\" IN ('P0', 'P1', 'P2', 'P3', 'P4', 'WISH')"
        },
        "tasks_due_date": {
          "name": "tasks_due_date",
          "value": "\"tasks\".\"due_date\" IS NULL OR \"tasks\".\"due_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]'"
        },
        "tasks_due_time": {
          "name": "tasks_due_time",
          "value": "\"tasks\".\"due_time\" IS NULL OR (\"tasks\".\"due_date\" IS NOT NULL AND \"tasks\".\"due_time\" GLOB '[0-2][0-9]:[0-5][0-9]')"
        },
        "tasks_duration": {
          "name": "tasks_duration",
          "value": "\"tasks\".\"duration_min\" IS NULL OR \"tasks\".\"duration_min\" BETWEEN 1 AND 1440"
        },
        "tasks_resolution": {
          "name": "tasks_resolution",
          "value": "(\"tasks\".\"completed_at\" IS NULL AND \"tasks\".\"resolution\" IS NULL) OR (\"tasks\".\"completed_at\" IS NOT NULL AND \"tasks\".\"resolution\" IS NOT NULL AND \"tasks\".\"resolution\" IN ('done', 'skipped'))"
        },
        "tasks_archived_requires_completed": {
          "name": "tasks_archived_requires_completed",
          "value": "\"tasks\".\"archived_at\" IS NULL OR \"tasks\".\"completed_at\" IS NOT NULL"
        },
        "tasks_links_json": {
          "name": "tasks_links_json",
          "value": "json_valid(\"tasks\".\"links_json\") AND json_type(\"tasks\".\"links_json\") = 'array'"
        },
        "tasks_version": {
          "name": "tasks_version",
          "value": "\"tasks\".\"version\" >= 1"
        }
      }
